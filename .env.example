# Copy to .env for local development. Never commit a real .env.
# Consumed by app/config.py (pydantic-settings). See specs build task T-0.3.

ENVIRONMENT=local

# PostgreSQL — durable structured data (specs/data-spec.md)
DATABASE_URL=postgresql://acme:acme@postgres:5432/acme
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=acme

# Redis — per-session memory (specs/data-spec.md section 3)
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600

# Keycloak — OIDC auth + RBAC (specs/adr/0004-keycloak-rbac.md)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=acme
KEYCLOAK_CLIENT_ID=acme-agent
# Dev-only admin bootstrap credentials for the Keycloak container
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Ollama — local LLM runtime (specs/adr/0002-ollama-llm-runtime.md)
OLLAMA_URL=http://ollama:11434
# Pinned model + tag for reproducible evaluation (specs/agent-spec.md section 6)
OLLAMA_MODEL=llama3.1:8b

# Arize Phoenix / OpenTelemetry (specs/observability-spec.md)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
OTEL_SERVICE_NAME=acme-operations-agent
